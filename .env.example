ARKMATX_ENVIRONMENT=development
ARKMATX_DATABASE_PATH=data/arkmatx.sqlite3
ARKMATX_MASTER_KEY=
ARKMATX_BOXBRAIN_URL=
ARKMATX_BOXBRAIN_TOKEN=

# Keep false until the backend is running in a controlled environment.
ARKMATX_ALLOW_NETWORK_PROBES=false
ARKMATX_ALLOW_PRIVATE_TARGETS=false
ARKMATX_ALLOW_UNTRUSTED_TLS=false
ARKMATX_CONNECTION_TIMEOUT_SECONDS=6
ARKMATX_CONNECTION_TEST_RATE_LIMIT=5
ARKMATX_CONNECTION_TEST_RATE_WINDOW_SECONDS=60
